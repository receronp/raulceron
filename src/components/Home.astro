---
import { content, orgs, type Locale } from '../i18n/content';
import { brand } from '../brand/brand';
import SectionHead from './SectionHead.astro';
import Frame from './Frame.astro';
import Tag from './Tag.astro';
import Logo from './Logo.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
---

<!-- ── Hero ─────────────────────────────────────────────────────────────── -->
<section class="border-b border-rule-accent">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <div class="flex items-center gap-3">
      <Frame class="h-4 w-4 text-ink" />
      <span class="eyebrow">{t.hero.eyebrow}</span>
    </div>

    <h1 class="mt-8 max-w-3xl text-4xl leading-[1.08] font-medium tracking-tight text-balance text-ink sm:text-5xl md:text-6xl">
      {t.hero.title}
    </h1>

    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-pretty text-ink-soft">
      {t.hero.lede}
    </p>

    <p class="mt-5 text-sm text-muted">{t.hero.note}</p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="bg-accent-strong px-6 py-3 text-sm font-medium text-paper transition hover:bg-ink"
      >
        {t.hero.cta}
      </a>
      <a
        href="#services"
        class="border border-rule-accent px-6 py-3 text-sm text-ink transition hover:border-accent-strong hover:text-accent-strong"
      >
        {t.hero.ctaSecondary}
      </a>
    </div>
  </div>
</section>

<!-- ── Services ─────────────────────────────────────────────────────────── -->
<section id="services" class="scroll-mt-20 border-b border-rule-accent bg-wash">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <SectionHead eyebrow={t.services.eyebrow} title={t.services.title} lede={t.services.lede} />

    <div class="mt-14 grid gap-px overflow-hidden border border-rule-accent bg-rule-accent sm:grid-cols-2">
      {t.services.items.map((s) => (
        <article class="flex flex-col gap-4 bg-paper p-7 sm:p-8">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-xs tracking-widest text-accent-strong">{s.n}</span>
            <h3 class="text-lg font-medium text-ink">{s.title}</h3>
          </div>
          <p class="text-sm leading-relaxed text-pretty text-muted">{s.body}</p>
          <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
            {s.tags.map((tag) => <Tag label={tag} />)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ── Work ─────────────────────────────────────────────────────────────── -->
<section id="work" class="scroll-mt-20 border-b border-rule-accent">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <SectionHead eyebrow={t.work.eyebrow} title={t.work.title} lede={t.work.lede} />

    <div class="mt-14 flex flex-col">
      {t.work.items.map((w, i) => (
        <article class:list={['grid gap-6 py-9 md:grid-cols-[1fr_2fr] md:gap-12', i > 0 && 'border-t border-rule-accent']}>
          <div>
            <h3 class="text-lg leading-snug font-medium text-ink">{w.title}</h3>
            <p class="mt-2 text-xs tracking-[0.14em] text-accent-strong uppercase">{w.region}</p>
          </div>
          <div>
            <p class="text-sm leading-relaxed text-pretty text-muted">{w.body}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {w.stack.map((s) => <Tag label={s} />)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ── Experience ───────────────────────────────────────────────────────── -->
<section id="experience" class="scroll-mt-20 border-b border-rule-accent bg-wash">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <SectionHead eyebrow={t.experience.eyebrow} title={t.experience.title} lede={t.experience.lede} />

    <h3 class="eyebrow mt-14">{t.experience.rolesLabel}</h3>
    <ol class="mt-4 border-t border-rule-accent">
      {t.experience.roles.map((r) => (
        <li class="org-row grid gap-x-10 gap-y-3 border-b border-rule-accent py-8 md:grid-cols-[10rem_1fr_7rem]">
          <div class="flex items-start max-md:order-first md:order-last md:justify-end md:pt-1">
            <Logo org={r.org} />
          </div>
          <div class="text-xs leading-relaxed md:order-first">
            <p class="tracking-[0.08em] text-accent-strong uppercase tabular-nums">{r.dates}</p>
            <p class="mt-1 text-muted">{r.place}</p>
          </div>
          <div>
            <h4 class="text-lg leading-snug font-medium text-ink">{r.role}</h4>
            <p class="mt-0.5 text-sm text-ink-soft">{r.company}</p>
            <p class="mt-3 text-sm leading-relaxed text-pretty text-muted">{r.body}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {r.tags.map((tag) => <Tag label={tag} />)}
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="grid gap-x-10 gap-y-2 py-8 md:grid-cols-[10rem_1fr_7rem]">
      <h3 class="eyebrow md:pt-0.5">{t.experience.educationLabel}</h3>
      <ul class="space-y-1.5 text-sm leading-relaxed text-muted">
        {t.experience.education.map((e) => (
          <li>
            <span class="font-medium text-ink">{e.degree}</span> · {e.school},
            <span class="tabular-nums">{e.year}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ── Skills & credentials ─────────────────────────────────────────────── -->
<section id="credentials" class="scroll-mt-20 border-b border-rule-accent">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <SectionHead eyebrow={t.credentials.eyebrow} title={t.credentials.title} lede={t.credentials.lede} />

    <div class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {t.credentials.skills.map((g) => (
        <div>
          <h3 class="text-sm font-medium text-ink">{g.group}</h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {g.items.map((item) => <Tag label={item} />)}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 grid gap-12 md:grid-cols-[3fr_2fr] md:gap-16">
      <div>
        <h3 class="eyebrow">{t.credentials.certsLabel}</h3>
        <ul class="mt-4 border-t border-rule-accent">
          {t.credentials.certs.map((c) => (
            <li class="org-row flex items-center gap-4 border-b border-rule-accent py-4">
              <div class="flex w-10 shrink-0 justify-center"><Logo org={c.org} /></div>
              <div class="min-w-0">
                <p class="text-sm leading-snug font-medium text-ink">{c.name}</p>
                <p class="mt-1 flex items-center gap-2 text-xs text-muted">
                  {c.active && <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />}
                  {orgs[c.org].name} · {c.status}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="eyebrow">{t.credentials.languagesLabel}</h3>
        <dl class="mt-4 border-t border-rule-accent">
          {t.credentials.languages.map((l) => (
            <div class="flex items-baseline justify-between gap-6 border-b border-rule-accent py-4">
              <dt class="text-sm font-medium text-ink">{l.name}</dt>
              <dd class="text-right text-xs leading-relaxed text-muted">{l.level}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<!-- ── Approach ─────────────────────────────────────────────────────────── -->
<section id="approach" class="scroll-mt-20 border-b border-rule-accent bg-wash">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <SectionHead eyebrow={t.approach.eyebrow} title={t.approach.title} />

    <div class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {t.approach.items.map((a, i) => (
        <div class="flex flex-col gap-3">
          <div class="h-1 w-12 bg-accent" />
          <h3 class="text-base font-medium text-ink">{a.title}</h3>
          <p class="text-sm leading-relaxed text-pretty text-muted">{a.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ── About ────────────────────────────────────────────────────────────── -->
<section class="border-b border-rule-accent">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <div class="grid gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
      <SectionHead eyebrow={t.about.eyebrow} title={t.about.title} />
      <div class="flex flex-col gap-5">
        {t.about.body.map((p) => (
          <p class="text-base leading-relaxed text-pretty text-ink-soft">{p}</p>
        ))}
      </div>
    </div>

    <h3 class="eyebrow mt-16">{t.about.placesLabel}</h3>
    <ol class="mt-4 grid gap-px overflow-hidden border border-rule-accent bg-rule-accent sm:grid-cols-2 lg:grid-cols-4">
      {t.about.places.map((pl) => (
        <li class="flex flex-col gap-2 bg-paper p-6">
          <p class="text-xs tracking-[0.08em] text-accent-strong uppercase tabular-nums">{pl.years}</p>
          <h4 class="text-lg font-medium text-ink">{pl.country}</h4>
          <p class="text-sm leading-relaxed text-pretty text-muted">{pl.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ── Contact ──────────────────────────────────────────────────────────── -->
<section id="contact" class="scroll-mt-20 bg-ink text-paper">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <div class="flex items-center gap-3">
      <Frame class="h-4 w-4 text-paper" />
      <span class="eyebrow" style="color: #a9a29a">{t.contact.eyebrow}</span>
    </div>

    <h2 class="mt-8 max-w-2xl text-3xl leading-tight font-medium tracking-tight text-balance sm:text-4xl">
      {t.contact.title}
    </h2>

    <p class="mt-5 max-w-xl text-base leading-relaxed text-pretty" style="color: #c6bfb6">
      {t.contact.body}
    </p>

    <a
      href={`mailto:${brand.email}`}
      class="mt-10 inline-block border-b-2 border-accent pb-1 text-2xl font-medium transition hover:text-accent sm:text-3xl"
    >
      {t.contact.cta}
    </a>

    <div class="mt-14 flex flex-col gap-3 border-t pt-8 text-sm sm:flex-row sm:items-center sm:justify-between" style="border-color: #3a3531; color: #a9a29a">
      <span class="flex items-center gap-2.5">
        <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--brand-accent)"></span>
        {t.contact.availability}
      </span>
      <span>{t.contact.billing}</span>
    </div>
  </div>
</section>
