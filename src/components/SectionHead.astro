---
import Frame from './Frame.astro';
interface Props { eyebrow: string; title: string; lede?: string }
const { eyebrow, title, lede } = Astro.props;
---
<div class="max-w-2xl">
  <div class="flex items-center gap-3">
    <Frame class="h-4 w-4 text-ink" />
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <h2 class="mt-5 text-3xl leading-tight font-medium tracking-tight text-ink sm:text-4xl">
    {title}
  </h2>
  {lede && <p class="mt-4 text-base leading-relaxed text-muted text-pretty">{lede}</p>}
</div>
